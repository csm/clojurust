;; cljrs.core.experimental — compatibility spellings for APIs now available
;; in clojure.core.
;;
;; Nothing here is referred into `user`; reach it with an explicit
;; (require '[cljrs.core.experimental :as x]).

(ns cljrs.core.experimental)

(defmacro future
  "Compatibility spelling of clojure.core/future."
  [& body]
  (list 'clojure.core/future-call (list 'fn [] (cons 'do body))))
